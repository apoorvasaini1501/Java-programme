class Pair<T, U> {
    T id;
    U name;

    Pair(T id, U name) {
        this.id = id;
        this.name = name;
    }

    void display() {
        System.out.println("ID: " + id);
        System.out.println("Name: " + name);
    }
}

class GenericPairDemo {
    public static void main(String[] args) {
        Pair<Integer, String> p = new Pair<>(101, "Rahul");
        p.display();
    }
}