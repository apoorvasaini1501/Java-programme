import java.util.Scanner;

class Factors {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter a number: ");
        int n = sc.nextInt();

        int i = 1;

        System.out.println("Factors are:");

        do {
            if (n % i == 0) {
                System.out.print(i + " ");
            }
            i++;
        } while (i <= n);
    }
}